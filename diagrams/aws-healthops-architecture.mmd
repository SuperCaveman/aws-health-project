%%{init: {'theme':'base','themeVariables': {'background':'#061A2E','primaryTextColor':'#EAF7FF','lineColor':'#8EC9E8','edgeLabelBackground':'#102E50','fontFamily':'Arial'}}}%%
flowchart TB
    subgraph PARTNERS["Healthcare partner"]
        H["Hospital PACS / imaging team<br/>DICOM MRI or CT"]
        V["Specialty imaging vendor<br/>secure user access"]
    end

    subgraph AWS["AWS HealthOps - deployed lean MVP"]
        direction TB
        subgraph INTAKE["1. Secure intake"]
            AUTHI["Cognito JWT + HealthOps API<br/>POST /intake/upload-url"]
            URL["5-minute presigned S3 PUT"]
            IN["S3 inbound zone"]
            CHECK["Routing Lambda<br/>.dcm + DICOM P10 marker"]
            AUTHI --> URL --> IN --> CHECK
        end

        subgraph GOVERNED["2. Governed healthcare data"]
            CLIN["S3 clinical-source zone<br/>encrypted and versioned"]
            QUAR["S3 quarantine zone<br/>invalid input isolated"]
            HIM["AWS HealthImaging datastore<br/>healthops-clinical-imaging"]
            AUDIT["S3 audit / evidence zone"]
            CHECK -->|"valid DICOM P10"| CLIN -->|"import when a licensed study is added"| HIM
            CHECK -->|"invalid or fake .dcm"| QUAR
            CHECK -. "routing evidence" .-> AUDIT
        end

        subgraph PROCESS["3. Event-driven provenance"]
            EVT["EventBridge rule<br/>Import Job Completed"]
            FLOW["Step Functions<br/>healthops-processing"]
            PROV["Provenance Lambda"]
            FUTURE["Future on-demand segmentation<br/>approved GLB / STL / SEG"]
            HIM --> EVT --> FLOW --> PROV --> FUTURE
            PROV -. "provenance record" .-> AUDIT
        end

        subgraph DELIVERY["4. Controlled delivery"]
            DER["S3 derived-assets zone<br/>approved assets only"]
            AUTHD["Cognito JWT"]
            API["HealthOps API<br/>GET /derived/{assetId}"]
            VIEW["Future web / Unreal viewer<br/>derived assets only"]
            FUTURE -. "future approved output" .-> DER
            DER --> API --> VIEW
            AUTHD --> API
        end
    end

    H --> AUTHI
    V --> AUTHI
    VIEW ~~~ TF

    subgraph CONTROL["5. Cross-cutting operations & cost controls"]
        direction TB
        TF["Terraform + GitHub Actions"]
        SEC["S3 encryption + versioning<br/>public access blocked"]
        IAM["Least-privilege IAM<br/>HealthImaging import role"]
        OPS["CloudWatch 7-day logs<br/>CloudTrail event history"]
        BUD["$1.50 monthly tagged budget<br/>80% alert"]
    end

    classDef partner fill:#DCEEFF,stroke:#2276C9,color:#092E59,stroke-width:2px;
    classDef intake fill:#FFF0DB,stroke:#E67E22,color:#6B3200,stroke-width:2px;
    classDef governed fill:#DCF4E5,stroke:#218B4B,color:#0D3C20,stroke-width:2px;
    classDef process fill:#EEE2FF,stroke:#7F4BC7,color:#35105E,stroke-width:2px;
    classDef delivery fill:#FFF7CC,stroke:#D4A800,color:#5C4700,stroke-width:2px;
    classDef control fill:#D9F2F5,stroke:#16808A,color:#053B41,stroke-width:2px;

    class H,V partner;
    class AUTHI,URL,IN,CHECK intake;
    class CLIN,QUAR,HIM,AUDIT governed;
    class EVT,FLOW,PROV,FUTURE process;
    class DER,AUTHD,API,VIEW delivery;
    class TF,SEC,IAM,OPS,BUD control;

    style PARTNERS fill:#0B2944,stroke:#4BA3D9,color:#EAF7FF,stroke-width:2px
    style AWS fill:#061A2E,stroke:#3D9ED0,color:#EAF7FF,stroke-width:3px
    style INTAKE fill:#103B5B,stroke:#5BB8E6,color:#EAF7FF,stroke-width:2px
    style GOVERNED fill:#0D344F,stroke:#49A7B9,color:#EAF7FF,stroke-width:2px
    style PROCESS fill:#122E58,stroke:#729EEA,color:#EAF7FF,stroke-width:2px
    style DELIVERY fill:#123B52,stroke:#61B8C8,color:#EAF7FF,stroke-width:2px
    style CONTROL fill:#08243D,stroke:#3D9ED0,color:#EAF7FF,stroke-width:2px
    linkStyle default stroke:#8EC9E8,stroke-width:2px
