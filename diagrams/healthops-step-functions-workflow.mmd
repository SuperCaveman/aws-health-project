flowchart LR
    EVENT["Amazon EventBridge<br/>AWS HealthImaging: Import Job Completed"]

    subgraph SFN["AWS Step Functions — healthops-processing (deployed)"]
        direction TB
        START(["Start"])
        RECORD["RecordProvenance task<br/>Invoke Lambda synchronously<br/>Pass the full event payload"]
